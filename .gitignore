# ── 비밀 정보 (가장 중요) ────────────────────────────
# 실제 키가 들어가는 파일은 절대 커밋하지 않는다.
# 공유는 .env.example 에 "이름만" 적는 방식으로 한다.
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.key
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

# ── 의존성 / 빌드 산출물 ──────────────────────────────
node_modules/
dist/
build/
.expo/
.expo-shared/
ios/
android/
*.ipa
*.apk
*.aab

# ── 도구 캐시 ────────────────────────────────────────
.turbo/
coverage/
*.tsbuildinfo
.eslintcache

# ── OS / 에디터 ──────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── 로그 ─────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
